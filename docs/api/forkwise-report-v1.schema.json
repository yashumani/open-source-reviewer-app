{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yashumani.github.io/open-source-reviewer-app/docs/api/forkwise-report-v1.schema.json",
  "title": "ForkWise Evidence-First Repository Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "analyzerVersion",
    "execution",
    "generatedAt",
    "repository",
    "context",
    "decision",
    "evidenceCoverage",
    "dimensions",
    "findings",
    "evidence",
    "claims",
    "unresolvedQuestions",
    "pilotChecklist",
    "limitations",
    "inventory"
  ],
  "properties": {
    "schemaVersion": { "const": "forkwise-report/v1" },
    "analyzerVersion": { "type": "string", "minLength": 1 },
    "execution": { "const": "static-only" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "jobId": { "type": "string" },
    "repository": {
      "type": "object",
      "additionalProperties": true,
      "required": ["url", "owner", "name", "commitSha"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "fullName": { "type": "string" },
        "defaultBranch": { "type": "string" },
        "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "commitUrl": { "type": "string", "format": "uri" }
      }
    },
    "context": {
      "$ref": "review-request-v1.schema.json#/$defs/reviewContext"
    },
    "decision": {
      "type": "string",
      "enum": ["Adopt", "Pilot", "Fork", "Avoid", "Insufficient evidence"]
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "decisionConfidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "evidenceCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "blockerCount": { "type": "integer", "minimum": 0 },
    "ownershipEffort": { "type": "string" },
    "ownershipBurden": { "type": "string" },
    "adoptionEffort": { "type": "string" },
    "nextAction": { "type": "string" },
    "dimensions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["score"],
        "properties": {
          "id": { "type": "string", "enum": ["fit", "trust", "run", "own", "exit"] },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "rating": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "string" },
          "findingIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "dimension", "severity", "title"],
        "properties": {
          "id": { "type": "string" },
          "ruleId": { "type": "string" },
          "dimension": { "type": "string" },
          "type": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "summary": { "type": "string" },
          "impact": { "type": "string" },
          "recommendation": { "type": "string" },
          "evidenceIds": { "type": "array", "items": { "type": "string" } },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "detail": { "type": "string" },
          "excerpt": { "type": ["string", "null"] }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" },
          "title": { "type": "string" },
          "verdict": { "type": "string" },
          "state": { "type": "string" },
          "rationale": { "type": "string" },
          "explanation": { "type": "string" },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "operations": { "type": "object" },
    "technologies": { "type": "array" },
    "unresolvedQuestions": { "type": "array", "items": { "type": "string" } },
    "pilotChecklist": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "inventory": { "type": "object" }
  }
}
